{
  "name": "daymark",
  "version": "0.1.0",
  "private": true,
  "description": "Daymark — make room for what matters",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "test": "node --test tests/*.test.mjs",
    "package:mac": "npm run build && node scripts/package-desktop.mjs mac",
    "package:win": "npm run build && node scripts/package-desktop.mjs win"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.0",
    "vite": "^7.1.0"
  },
  "productName": "Daymark"
}
